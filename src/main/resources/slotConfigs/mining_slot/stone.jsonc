{
    "reels": 3,
    "shuffleTime": 2.5,
    "spinCost": 400,
    "spinSpeed": 0.8,
    "shuffleSpeed": 1.5,
    "loseStockOperation": "ADD",
    "loseStockValue": 50,
    "loseMessage": "&cハズレ...",
    "defaultSoundSettings": {
        "startSound": {
            "type": "minecraft:block.note_block.pling"
        },
        "reelStopSound": {
            "type": "minecraft:block.note_block.bass",
            "volume": 1.0
        },
        "endLoseSound": {
            "type": "minecraft:block.note_block.bell"
        },
        "rotatingSound": {
            "type": "minecraft:block.stone.break"
        }
    },
    "variables": [
        {
            "varName": "rotateCount",
            "initialValue": 0
        },
        {
            "varName": "HP",
            "initialValue": 10
        },
        {
            "varName": "damage",
            "initialValue": 0
        },
        {
            "varName": "propability",
            "initialValue": 0
        },
        {
            "varName": "ironCount",
            "initialValue": 0
        }
    ],
    "event": [
        {
            "condition": "1",
            "varCalc": "rotateCount=rotateCount+1"
        },
        {
            "condition": "rotateCount<120",
            "varCalc": "propability=rotateCount"
        },
        {
            "condition": "rotateCount%15==0 && HP<10",
            "varCalc": "HP=HP+1",
            "message": "&d&l時間経過によりHPが1回復した!",
            "eventSound": {
                "type": "minecraft:block.amethyst_cluster.fall",
                "volume": 1.0
              }
        },
        {
            "condition":"rotateCount==1",
            "varCalc":"ironCount=0"
        },
        {
            "condition":"rotateCount==1",
            "varCalc":"propability=0"
        }
    ],
    "patterns": [
        { //ツルハシの破壊
            "items": [
                "stick",
                "stick",
                "stick"
            ],
            "probability": "propability/4",//max約30
            "winMessage": "&6&lツルハシが壊れてしまったので帰宅した!\n&e¥<profit>&eを手に入れた!",
            "patternSound": {
                "type": "minecraft:item.shield.break",
                "volume": 1.0
            },
            "nextSlotOnWin": "mining_slot/main",
            "event": [
                {
                    "condition": "1",
                    "varCalc": "ironCount=0"
                },
                {
                    "condition":"1",
                    "varCalc":"rotateCount=0"
                }
            ],
            "rewards": [
                {
                    "type": "money",
                    "value": "stock"
                }
            ],
            "stockOperation": "SET",
            "stockValue": 0
        },
        { //石
            "items": [
                "stone",
                "stone",
                "stone"
            ],
            "probability": 15,
            "winMessage": "&b石揃い! stockが100増えた!",
            "patternSound": {
                "type": "minecraft:entity.arrow.hit_player"
            },
            "stockOperation": "ADD",
            "stockValue": 100
        },
        { //花崗岩
            "items": [
                "granite",
                "granite",
                "granite"
            ],
            "probability": 5,
            "winMessage": "&b花崗岩揃い! ストックが250増えた!",
            "patternSound": {
                "type": "minecraft:entity.arrow.hit_player"
            },
            "stockOperation": "ADD",
