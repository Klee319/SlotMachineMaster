{
    "reels": 3,
    "shuffleTime": 2.5,
    "spinCost": 400,
    "spinSpeed": 0.8,
    "shuffleSpeed": 1.5,
    "loseStockOperation": "ADD",
    "loseStockValue": 50,
    "loseMessage": "&cハズレ...",
    "defaultSoundSettings": {
        "startSound": {
            "type": "minecraft:block.note_block.pling"
        },
        "reelStopSound": {
            "type": "minecraft:block.note_block.bass",
            "volume": 1.0
        },
        "endLoseSound": {
            "type": "minecraft:block.note_block.bell"
        },
        "rotatingSound": {
            "type": "minecraft:block.stone.break"
        }
    },
    "variables": [
        {
            "varName": "rotateCount",
            "initialValue": 0
        },
        {
            "varName": "HP",
            "initialValue": 10
        },
        {
            "varName": "damage",
            "initialValue": 0
        },
        {
            "varName": "propability",
            "initialValue": 0
        },
        {
            "varName": "obsidianCount",
            "initialValue": 0
        },
        {
            "varName": "diamondCount",
            "initialValue": 0
        },
        {
            "varName": "bonus",
            "initialValue": 0
        },
        {
            "varName": "result",
            "initialValue": 0
        }
    ],
    "event": [
        {
            "condition": "1",
            "varCalc": "rotateCount=rotateCount+1"
        },
        {
            "condition": "rotateCount<300",
            "varCalc": "propability=rotateCount"
        },
        {
            "condition": "rotateCount%15==0 && HP<10",
            "varCalc": "HP=HP+1",
            "message": "&d&l時間経過によりHPが1回復した!",
            "eventSound": {
                "type": "minecraft:block.amethyst_cluster.fall",
                "volume": 1.0
            }
        },
        {
            "condition": "rotateCount==1",
            "varCalc": "diamondCount=0"
        },
        {
            "condition": "rotateCount==1",
            "varCalc": "propability=0"
        },
        {
            "condition": "rotateCount==1",
            "varCalc": "obsidianCount=0"
        },
        {
            "condition": "rotateCount==1",
            "varCalc": "bonus=0"
        },
        {
            "condition": "rotateCount==1",
            "varCalc": "result=0"
        }
    ],
    "patterns": [
        { //ツルハシの破壊
            "items": [
                "stick",
                "stick",
