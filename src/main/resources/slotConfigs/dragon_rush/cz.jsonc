{
  // ============================================================
  // エンダードラゴン討伐 ～竜の試練～
  // CZ「竜の試練」コンフィグ
  // ============================================================
  //
  // 【ゲーム性】
  // - 10G継続のチャンスゾーン
  // - AT突入を目指す！
  // - レア役で突入濃厚、小役でも勝利期待度UP
  // - ゲーム数消化でドラゴンバトル発展！
  //
  // 【変数】
  // czGame: CZ残りゲーム数
  // czWin: AT当選フラグ (0=未当選, 1=当選)
  // battlePower: バトル勝利期待度(0-100)
  // ============================================================

  "reels": 3,
  "shuffleTime": 2.0,
  "shuffleSpeed": 0.36,
  "spinSpeed": 1.8,
  "spinCost": 3,

  // === 変数初期化 ===
  "variables": [
    { "varName": "czGame", "initialValue": 10 },
    { "varName": "czWin", "initialValue": 0 },
    { "varName": "battlePower", "initialValue": 30 }
  ],

  // === 負け時設定 ===
  "loseStockOperation": "add",
  "loseStockValue": 0,
  "loseMessage": "&8[&5竜の試練&8] &f残り&e<czGame>&fG &8| &7勝率 &a<battlePower>&7%",

  // === サウンド設定 ===
  "defaultSoundSettings": {
    "startSound": {
      "type": "minecraft:entity.ender_dragon.flap",
      "volume": 0.7,
      "pitch": 1.5,
      "radius": 12
    },
    "rotatingSound": {
      "type": "minecraft:block.note_block.pling",
      "volume": 0.4,
      "pitch": 1.8,
      "radius": 10
    },
    "reelStopSound": {
      "type": "minecraft:block.note_block.bass",
      "volume": 1.0,
      "pitch": 0.6,
      "radius": 12
    },
    "endLoseSound": {
      "type": "minecraft:block.note_block.bit",
      "volume": 0.6,
      "pitch": 1.0,
      "radius": 8
    }
  },

  // === パーティクル設定 ===
  "defaultParticleSettings": [
    {
      "point": "frame",
      "particle": "DRAGON_BREATH",
      "count": 15,
      "speed": 0.05,
      "offset": [0.5, 0.5, 0.5]
    },
    {
      "point": "button",
      "particle": "END_ROD",
      "count": 10,
      "speed": 0.1,
      "offset": [0.3, 0.3, 0.3]
    }
  ],

  // ============================================================
  // グローバルイベント（毎スピン判定）
  // ============================================================
  "event": [
    // --- ゲームカウント減算 ---
    {
      "condition": "1",
      "varCalc": "czGame = czGame - 1"
    },

    // --- 残り5Gで煽り ---
    {
      "condition": "czGame == 5",
      "message": "&e  折り返し！ 勝率: &a<battlePower>&e%",
      "eventSound": {
        "type": "minecraft:entity.ender_dragon.ambient",
        "volume": 0.8,
        "pitch": 1.0,
        "radius": 15
      }
    },

    // --- ラストゲーム ---
    {
      "condition": "czGame == 1",
      "message": "\n&8&m                                        \n&c&l  ラストゲーム！\n&e  勝率: &a&l<battlePower>&e%\n&8&m                                        ",
      "eventSound": {
        "type": "minecraft:entity.ender_dragon.growl",
        "volume": 1.0,
        "pitch": 0.8,
        "radius": 20
      }
    },

    // --- CZ終了（AT当選時）---
    {
      "condition": "czGame <= 0 && czWin == 1",
      "varCalc": "gameCount = 0",
      "message": "\n&8&m                                        \n&a&l  ドラゴン撃破！\n&a&l  >> ドラゴンラッシュ突入！\n&8&m                                        ",
      "eventSound": {
        "type": "minecraft:entity.ender_dragon.death",
        "volume": 1.0,
        "pitch": 1.0,
        "radius": 30
      },
      "nextSlotOnWin": "dragon_rush/at"
    },

    // --- CZ終了（バトル逆転勝利）---
    {
      "condition": "czGame <= 0 && czWin == 0 && battlePower >= 60",
      "varCalc": "czWin = 1",
      "message": "&a&l  逆転勝利！"
    },

    // --- CZ終了（失敗）---
    {
      "condition": "czGame <= 0 && czWin == 0",
      "message": "\n&8&m                                        \n&7  敗北... ドラゴンに負けた\n&7  通常時へ\n&8&m                                        ",
      "eventSound": {
        "type": "minecraft:entity.ender_dragon.hurt",
        "volume": 0.8,
        "pitch": 0.5,
        "radius": 15
      },
      "nextSlotOnWin": "dragon_rush/normal"
    }
  ],

  // ============================================================
  // 当選パターン
  // ============================================================
  "patterns": [

    // 【確定役】ドラゴンエッグ揃い - AT確定！
    {
      "probability": 0.5,
      "items": ["DRAGON_EGG", "DRAGON_EGG", "DRAGON_EGG"],
      "rewards": [
        { "type": "money", "value": "200" }
      ],
      "winMessage": "\n&8&m                                        \n&5  &d&l★ ドラゴンエッグ揃い ★\n&a&l  AT確定！ &e+200枚\n&8&m                                        ",
      "patternSound": {
        "type": "minecraft:entity.ender_dragon.death",
        "volume": 1.0,
        "pitch": 1.0,
        "radius": 30
      },
      "particleSettings": [
        {
          "point": "frame",
          "particle": "DRAGON_BREATH",
          "count": 200,
          "speed": 0.5,
          "offset": [1.0, 1.0, 1.0]
        }
      ],
      "event": [
        {
          "condition": "1",
          "varCalc": "czWin = 1; battlePower = 100"
        }
      ]
    },

    // 【強役】ネザースター揃い - 勝率大幅UP
    {
      "probability": 2.0,
      "items": ["NETHER_STAR", "NETHER_STAR", "NETHER_STAR"],
      "rewards": [
        { "type": "money", "value": "50" }
      ],
      "winMessage": "&e  ネザースター揃い &a+50枚 &f- 勝率&a+30%&f！",
      "patternSound": {
        "type": "minecraft:entity.wither.ambient",
        "volume": 0.9,
        "pitch": 1.0,
        "radius": 15
      },
      "particleSettings": [
        {
          "point": "frame",
          "particle": "END_ROD",
          "count": 80,
          "speed": 0.4,
          "offset": [0.5, 0.5, 0.5]
        }
      ],
      "event": [
        {
          "condition": "1",
          "varCalc": "battlePower = battlePower + 30"
        },
        {
          "condition": "stock >= 100",
          "varCalc": "czWin = 1",
          "message": "&a&l  >> この時点でAT確定！"
        }
      ]
    },

    // 【レア役】エンダーパール揃い - 勝率UP
    {
      "probability": 8.0,
      "items": ["ENDER_PEARL", "ENDER_PEARL", "ENDER_PEARL"],
      "rewards": [
        { "type": "money", "value": "15" }
      ],
      "winMessage": "&d  エンダーパール揃い &a+15枚 &f- 勝率&a+15%",
      "patternSound": {
        "type": "minecraft:entity.enderman.teleport",
        "volume": 0.8,
        "pitch": 1.2,
        "radius": 12
      },
      "particleSettings": [
        {
          "point": "frame",
          "particle": "PORTAL",
          "count": 60,
          "speed": 0.3,
          "offset": [0.5, 0.5, 0.5]
        }
      ],
      "event": [
        {
          "condition": "1",
          "varCalc": "battlePower = battlePower + 15"
        }
      ]
    },

    // 【強レア役】ブレイズロッド揃い - 勝率大UP
    {
      "probability": 5.0,
      "items": ["BLAZE_ROD", "BLAZE_ROD", "BLAZE_ROD"],
      "rewards": [
        { "type": "money", "value": "20" }
      ],
      "winMessage": "&6  ブレイズロッド揃い &a+20枚 &e- 勝率&a+25%&e！",
      "patternSound": {
        "type": "minecraft:entity.blaze.shoot",
        "volume": 1.0,
        "pitch": 0.9,
        "radius": 15
      },
      "particleSettings": [
        {
          "point": "frame",
          "particle": "FLAME",
          "count": 100,
          "speed": 0.4,
          "offset": [0.5, 0.5, 0.5]
        }
      ],
      "event": [
        {
          "condition": "1",
          "varCalc": "battlePower = battlePower + 25"
        }
      ]
    },

    // 【メイン小役】ダイヤモンド揃い
    {
      "probability": 20.0,
      "items": ["DIAMOND", "DIAMOND", "DIAMOND"],
      "rewards": [
        { "type": "money", "value": "10" }
      ],
      "winMessage": "&b  ダイヤモンド揃い &a+10枚 &7- 勝率+5%",
      "patternSound": {
        "type": "minecraft:block.amethyst_block.chime",
        "volume": 0.8,
        "pitch": 1.3,
        "radius": 8
      },
      "event": [
        {
          "condition": "1",
          "varCalc": "battlePower = battlePower + 5"
        }
      ]
    },

    // 【リプレイ】エンダーアイ揃い
    {
      "probability": 25.0,
      "items": ["ENDER_EYE", "ENDER_EYE", "ENDER_EYE"],
      "rewards": [],
      "winMessage": "&8  リプレイ &7(勝率+2%)",
      "patternSound": {
        "type": "minecraft:entity.enderman.ambient",
        "volume": 0.5,
        "pitch": 1.3,
        "radius": 5
      },
      "event": [
        {
          "condition": "1",
          "varCalc": "battlePower = battlePower + 2"
        }
      ]
    },

    // 【チャンス目】エッグ挟み - 期待度大UP
    {
      "probability": 3.0,
      "items": ["DRAGON_EGG", "ENDER_PEARL", "DRAGON_EGG"],
      "rewards": [
        { "type": "money", "value": "15" }
      ],
      "winMessage": "&d&l  チャンス目！ &a+15枚 &e- 勝率&a+20%&e！",
      "patternSound": {
        "type": "minecraft:block.note_block.chime",
        "volume": 1.0,
        "pitch": 2.0,
        "radius": 12
      },
      "particleSettings": [
        {
          "point": "frame",
          "particle": "ENCHANT",
          "count": 50,
          "speed": 0.5,
          "offset": [0.5, 0.5, 0.5]
        }
      ],
      "event": [
        {
          "condition": "1",
          "varCalc": "battlePower = battlePower + 20"
        }
      ]
    }
  ]
}
